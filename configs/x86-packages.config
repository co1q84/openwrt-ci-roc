# GeoIP.dat for OpenClash, linked by x86-build.py so it works before any download.
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
# partx: SSD migration and full-image sysupgrade refresh the kernel partition table.
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_sysfsutils=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y

# Preserve the existing router diagnostic command-line tools.
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-8139too=y

# Removed from this router: unused services, duplicate proxy stacks and example-only apps.
# These selections come from General.config, which the Taiyi target still uses.
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-acme is not set
# CONFIG_PACKAGE_luci-app-banip is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# Simplified Chinese only; Traditional Chinese translations are not used here.
# CONFIG_LUCI_LANG_zh_Hant is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-app-dufs is not set
# CONFIG_PACKAGE_luci-app-filebrowser-go is not set
# Docker is not installed by default (General.config selects it for Taiyi).
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_docker-compose is not set

# Vantage theme and its companion dashboard (Argon stays the selected theme).
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y
# Optional Vantage name sources: reverse DNS and mDNS client names.
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_umdns=y

# Alerts (reboot, WAN/IP changes, new devices) and long-term traffic statistics.
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-vnstat2=y

# BBR for the router's own TCP (OpenClash/mihomo proxied connections); the package
# sets only tcp_congestion_control=bbr and keeps fq_codel for forwarded traffic.
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Hardware watchdog: on Gemini Lake (J4125) i2c-i801 registers the iTCO timer,
# which procd then feeds; a hung system reboots instead of staying down.
CONFIG_PACKAGE_kmod-i2c-i801=y
CONFIG_PACKAGE_kmod-itco-wdt=y
