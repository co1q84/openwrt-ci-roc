#!/bin/sh
# Public standalone entry for J4125 firmware updates. No unattended flashing.
# shellcheck disable=SC1091,SC2015
# SC2015: "A && B || { fail ...; return 1; }" is deliberate; the fallback always fails.
set -eu
umask 077

REPOSITORY=co1q84/openwrt-ci-roc
# SSD data partition: starts at 4 GiB, leaving room should the system area ever grow.
DATA_START=8388608
DATA_MOUNT=/mnt/data

fail() { printf '停止：%s\n' "$*" >&2; return 1; }

is_current_build() {
    [ -r "$1" ] && jq -e --arg tag "$2" '.schema == 1 and .tag == $tag' "$1" >/dev/null 2>&1
}

proxy_listening() { netstat -lnt 2>/dev/null | grep -q ":$1 "; }

fetch() {
    # fetch URL OUT [proxy-port]; a proxy password reaches curl only via stdin.
    set -- "$1" "$2" "${3:-}"
    case "$1" in */releases/assets/*) accept='Accept: application/octet-stream';; *) accept='Accept: application/json';; esac
    if [ -n "$3" ]; then
        if [ "$(uci -q get 'openclash.@authentication[0].enabled')" = 1 ]; then
            credentials=$(printf '%s:%s' "$(uci -q get 'openclash.@authentication[0].username')" \
                "$(uci -q get 'openclash.@authentication[0].password')" | sed 's/[\\"]/\\&/g')
            printf 'proxy-user = "%s"\n' "$credentials"
        fi | curl -K - -x "http://127.0.0.1:$3" --fail --location --retry 3 --connect-timeout 20 \
            --proto '=https' --tlsv1.2 --silent --show-error -C - -H "$accept" "$1" -o "$2"
    else
        curl --fail --location --retry 3 --connect-timeout 20 --proto '=https' --tlsv1.2 \
            --silent --show-error -C - -H "$accept" "$1" -o "$2" < /dev/null
    fi
}

download() {
    # GitHub is slow or unreliable from the router directly; prefer the local
    # OpenClash mixed port when it is running. Integrity comes from SHA256.
    port=$(uci -q get openclash.config.mixed_port || :)
    if [ -n "$port" ] && proxy_listening "$port"; then
        fetch "$1" "$2.part" "$port" && { mv "$2.part" "$2"; return 0; }
        printf '经本机 OpenClash 下载失败，改为直连重试。\n' >&2
    fi
    fetch "$1" "$2.part" || return 1
    mv "$2.part" "$2"
}

asset_url() {
    # API asset endpoint of the selected release (github.com/releases/download
    # has been seen failing with 504 while the API kept working).
    jq -er --arg tag "$TAG" --arg name "$1" \
        '.[] | select(.tag_name == $tag) | .assets[] | select(.name == $name) | .url' "$WORK/releases.json" ||
        { fail "发布中缺少文件：$1"; return 1; }
}

verify_asset() {
    [ -s "$1" ] || { fail '下载文件为空'; return 1; }
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum "$1" | cut -d ' ' -f 1)
    else
        actual=$(shasum -a 256 "$1" | cut -d ' ' -f 1)
    fi
    [ "$actual" = "$2" ] || { fail 'SHA256 不匹配'; return 1; }
}

validate_metadata() {
    jq -e '
      .schema == 1 and .repository == "co1q84/openwrt-ci-roc" and
      (.tag | test("^x86-64-[0-9]+-[0-9]+$")) and
      .target == "x86/64" and .device == "J4125-4L" and
      .image.boot == "efi" and .image.filesystem == "squashfs" and
      (.image.name | test("^immortalwrt-x86-64-generic-squashfs-combined-efi[.]img[.]gz$")) and
      (.image.sha256 | test("^[0-9a-f]{64}$")) and
      (.image.size | type == "number" and . > 0) and
      (.image.partitions | length == 2) and
      .image.partitions[0][0] == 1 and .image.partitions[0][2] == 131072 and
      .image.partitions[1][0] == 2 and .image.partitions[1][2] == 4194304 and
      .image.partitions[0][1] > 0 and
      .image.partitions[1][1] >= (.image.partitions[0][1] + 131072)
    ' "$1" >/dev/null || { fail '发布元数据或硬件/分区类型不匹配'; return 1; }
}

check_device() {
    [ "$(uname -m)" = x86_64 ] || { fail '需要 x86_64'; return 1; }
    [ -d /sys/firmware/efi ] || { fail '当前系统不是 UEFI 启动'; return 1; }
    [ "$(cat /sys/class/dmi/id/product_name)" = J4125-4L ] || { fail '设备型号不匹配'; return 1; }
    grep -q ' /rom squashfs ' /proc/mounts || { fail '当前根文件系统不是 squashfs'; return 1; }
}

get_release() {
    download "https://api.github.com/repos/$REPOSITORY/releases?per_page=30" "$WORK/releases.json" || return 1
    TAG=$(jq -er '[.[] | select(.draft == false and .prerelease == false) |
        select(.tag_name | test("^x86-64-[0-9]+-[0-9]+$"))][0].tag_name // empty' "$WORK/releases.json") || {
        fail '尚无经过校验的 x86 固件发布'; return 1;
    }
    download "$(asset_url release.json)" "$WORK/release.json" || return 1
    validate_metadata "$WORK/release.json" || return 1
    [ "$(jq -r .tag "$WORK/release.json")" = "$TAG" ] || { fail '发布标签不一致'; return 1; }
    printf '可用固件：%s\n' "$TAG"
    jq -r '"内核：\(.kernel)  构建时间：\(.built_at)"' "$WORK/release.json"
    if [ -r /etc/firmware-build.json ]; then
        jq -r '"当前固件：\(.tag)"' /etc/firmware-build.json
    fi
    UP_TO_DATE=0
    if is_current_build /etc/firmware-build.json "$TAG"; then
        UP_TO_DATE=1
        printf '已经安装当前最新发布，无需重复升级。\n'
        return 0
    fi
    apk list --installed 2>/dev/null | jq -Rn '
      [inputs | split(" ")[0] | try capture("^(?<name>.+)-(?<version>[0-9][^-]*(?:-r[0-9]+)?)$") |
       {key:.name,value:.version}] | from_entries' > "$WORK/installed.json" || return 1
    jq -r --slurpfile old "$WORK/installed.json" '
      .packages as $new |
      ($new | to_entries[] | select($old[0][.key] != .value) |
        "\(.key): \($old[0][.key] // "未安装") -> \(.value)"),
      ($old[0] | keys[] | select($new[.] == null) | "\(.): 新镜像未集成")
    ' "$WORK/release.json" > "$WORK/package-diff.txt" || return 1
    printf '包差异共 %s 项，完整列表：%s/package-diff.txt\n' "$(wc -l < "$WORK/package-diff.txt")" "$WORK"
    head -35 "$WORK/package-diff.txt"
}

openwrt_call() (
    # Upstream OpenWrt libraries intentionally read optional unset variables.
    # Isolate their environment so the updater itself keeps nounset enabled.
    set +u
    . "$1/functions.sh"
    . "$1/upgrade/common.sh"
    shift
    export VERBOSE=0
    "$@"
)

normalize_partitions() {
    [ "$(dd if="$1" bs=1 skip=512 count=8 2>/dev/null)" = 'EFI PART' ] || {
        fail '需要 GPT/EFI 分区表'; return 1
    }
    while read -r number start sectors; do
        type=$(hexdump -v -n 16 -s "$((1024 + (number - 1) * 128))" -e '16/1 "%02x"' "$1") || return 1
        [ "${#type}" -eq 32 ] || { fail '无法读取 GPT 分区类型'; return 1; }
        # ptgen reserves a tiny GPT BIOS-boot partition for GRUB. Keep real data partitions.
        [ "$type" != 4861682149646f6e744e656564454649 ] || continue
        printf '%s\t%s\t%s\n' "$number" "$start" "$sectors"
    done
}

partition_map() {
    rm -f "/tmp/partmap.fwup-$$"
    get_partitions "$1" "fwup-$$" || return 1
    [ -s "/tmp/partmap.fwup-$$" ] || { fail '无法读取分区表'; return 1; }
    normalize_partitions "$1" < "/tmp/partmap.fwup-$$" || return 1
    rm -f "/tmp/partmap.fwup-$$"
}

device_map() {
    if ! export_bootdevice || ! export_partdevice DISK 0; then
        fail '无法确定当前启动盘'; return 1
    fi
    printf '%s\n' "$DISK" > "$WORK/boot-device"
    partition_map "/dev/$DISK"
}

layout_compatible() {
    # Every image partition must exist unchanged. Extra partitions (the SSD data
    # partition) are kept by sysupgrade and must not overlap the system area.
    awk -F '\t' '
      NR == FNR { want[$1] = $0; first = (first == "" || $2 < first) ? $2 : first
                  end = ($2 + $3 > end) ? $2 + $3 : end; next }
      $1 in want { if ($0 != want[$1]) bad = 1; seen[$1] = 1; next }
      { if ($2 < end) bad = 1 }
      END { for (n in want) if (!(n in seen)) bad = 1; exit bad }
    ' "$2" "$1"
}

read_device_layout() {
    jq -r '.image.partitions[] | @tsv' "$WORK/release.json" > "$WORK/expected.partitions"
    check_layout
}

only_system_partitions() {
    # only_system_partitions DEVICE IMAGE: the disk holds no partition beyond the image's own.
    awk -F '\t' 'NR == FNR { want[$1] = 1; next } !($1 in want) { bad = 1 } END { exit bad }' "$2" "$1"
}

check_layout() {
    openwrt_call /lib device_map > "$WORK/device.partitions" || return 1
    if ! layout_compatible "$WORK/device.partitions" "$WORK/expected.partitions"; then
        # A changed system layout makes sysupgrade write the whole disk. Its
        # configuration is still restored, but any extra partition is lost.
        only_system_partitions "$WORK/device.partitions" "$WORK/expected.partitions" || {
            fail '分区布局已变化，且启动盘上有数据分区：整盘写入会丢失它。请从另一块启动盘运行 migrate 重装'; return 1;
        }
        LAYOUT_CHANGE=1
        printf '注意：新固件分区布局不同，将整盘重写当前启动盘；配置照常保留，自行安装到 overlay 的软件包需重装。\n'
    fi
    printf '已核对当前启动盘：/dev/%s（不会按固定 sda/sdb 选择磁盘）\n' "$(cat "$WORK/boot-device")"
}

system_fits_before_data() {
    # system_fits_before_data LAYOUT: the system area ends before the SSD data partition.
    awk -F '\t' -v limit="$DATA_START" '$2 + $3 > limit { bad = 1 } END { exit bad }' "$1"
}

prepare_image() {
    IMAGE="$WORK/$(jq -r .image.name "$WORK/release.json")"
    size=$(jq -r .image.size "$WORK/release.json")
    free_kb=$(df -Pk /tmp | awk 'END {print $4}')
    [ "$free_kb" -gt "$((size * 2 / 1024 + 524288))" ] || { fail '/tmp 空间不足'; return 1; }
    download "$(asset_url "$(basename "$IMAGE")")" "$IMAGE" || return 1
    verify_asset "$IMAGE" "$(jq -r .image.sha256 "$WORK/release.json")" || return 1
    [ "$(wc -c < "$IMAGE")" -eq "$size" ] || { fail '镜像大小不匹配'; return 1; }
    gzip -t "$IMAGE" || return 1
    image_header "$IMAGE" "$WORK/image.header"
    openwrt_call /lib partition_map "$WORK/image.header" > "$WORK/image.partitions" || return 1
    cmp -s "$WORK/image.partitions" "$WORK/expected.partitions" || { fail '镜像实际分区与元数据不同'; return 1; }
    sysupgrade -T "$IMAGE" || { fail 'sysupgrade 镜像检查未通过'; return 1; }
}

disk_name() { export_bootdevice && export_partdevice DISK 0 && printf '%s\n' "$DISK"; }

boot_disk() {
    name=$(openwrt_call /lib disk_name) && [ -n "$name" ] || { fail '无法确定当前启动盘'; return 1; }
    printf '%s\n' "$name"
}

is_block() { [ -b "$1" ]; }

partition_device() {
    case "$1" in *[0-9]) printf '%sp%s\n' "$1" "$2";; *) printf '%s%s\n' "$1" "$2";; esac
}

check_target_disk() {
    sys=${SYSFS:-/sys}
    name=${1#/dev/}
    [ "/dev/$name" = "$1" ] && is_block "$1" && [ -d "$sys/block/$name" ] || {
        fail "$1 不是整块磁盘"; return 1;
    }
    [ "$name" != "$(boot_disk)" ] || { fail "$1 是当前启动盘"; return 1; }
    [ "$(cat "$sys/block/$name/removable")" = 0 ] || { fail "$1 是可移动设备，不是 SSD"; return 1; }
    ! grep -q "^/dev/$name" "${PROC_MOUNTS:-/proc/mounts}" || { fail "$1 有已挂载分区"; return 1; }
    ! grep -q "^/dev/$name" "${PROC_SWAPS:-/proc/swaps}" || { fail "$1 正被用作交换分区"; return 1; }
    sectors=$(cat "$sys/block/$name/size")
    [ "$sectors" -gt "$((DATA_START + 4194304))" ] || { fail "$1 容量不足"; return 1; }
}

root_partuuid() {
    # GPT entry 2 (rootfs) unique GUID; the bootloader finds root by it.
    hexdump -v -n 16 -s $((1024 + 128 + 16)) -e '16/1 "%02x"' "$1"
}

distinct_root_ids() {
    image_id=$(root_partuuid "$1") && disk_id=$(root_partuuid "$2") || return 1
    [ "${#image_id}" -eq 32 ] && [ "$image_id" != "$disk_id" ] || {
        fail '新镜像与当前启动盘的系统分区 ID 相同，两块盘同时在位会启动错乱'; return 1;
    }
}

confirm_migration() {
    printf '将清空 %s 上的全部数据，写入新固件并创建数据分区。\n输入 ERASE %s 确认：' "$1" "$1"
    IFS= read -r reply || return 1
    [ "$reply" = "ERASE $1" ] || { fail '未确认清空目标盘'; return 1; }
}

image_header() {
    # Only a header is needed; gzip may receive SIGPIPE once dd has read it.
    gzip -dc "$1" | dd of="$2" bs=512 count=512 2>/dev/null || :
}

# Migration edits work on copies with a unique package name. This uci cannot
# commit from a private save directory, and staged deltas under live names
# (network, dhcp...) could be applied to the running system by LuCI.
uci_name() { printf 'fwmig%s_%s' "$$" "$1"; }

uci_get() {
    # uci_get PACKAGE OPTION from the private copy (created on first use).
    name=$(uci_name "$1")
    [ -f "$WORK/uci-edit/$name" ] || { mkdir -p "$WORK/uci-edit" && cp "$conf/$1" "$WORK/uci-edit/$name"; } || return 1
    uci -q -c "$WORK/uci-edit" get "$name.$2"
}

uci_edit() {
    # uci_edit PACKAGE < batch lines written against "PKG."
    name=$(uci_name "$1")
    save=${UCI_SAVEDIR:-/tmp/.uci}
    [ -f "$WORK/uci-edit/$name" ] || { mkdir -p "$WORK/uci-edit" && cp "$conf/$1" "$WORK/uci-edit/$name"; } || return 1
    [ ! -e "$save/$name" ] || { fail "uci 暂存冲突：$save/$name"; return 1; }
    { sed "s/ PKG\./ $name./"; printf 'commit %s\n' "$name"; } | uci -q -c "$WORK/uci-edit" batch
    status=$?
    rm -f "$save/$name"
    [ "$status" = 0 ] || { fail "无法修改 $1 配置"; return 1; }
    cp "$WORK/uci-edit/$name" "$conf/$1"
}

expect() {
    [ "$(uci_get "$1" "$2")" = "$3" ] || { fail "迁移配置未生效：$1.$2"; return 1; }
}

ssd_config() {
    # The first SSD boot restores this configuration in its final state.
    conf=$WORK/migration/etc/config
    hosts='223.5.5.5 119.29.29.29'
    [ -f "$conf/fstab" ] || printf "config global\n\toption auto_mount '1'\n" > "$conf/fstab"
    uci_edit fstab <<EOF || return 1
set PKG.ssd_data=mount
set PKG.ssd_data.target=$DATA_MOUNT
set PKG.ssd_data.uuid=$1
set PKG.ssd_data.enabled=1
EOF
    expect fstab ssd_data.uuid "$1" && expect fstab ssd_data.target "$DATA_MOUNT" &&
        expect fstab ssd_data.enabled 1 || return 1
    if [ -f "$conf/dockerd" ]; then
        echo "set PKG.globals.data_root=$DATA_MOUNT/docker/" | uci_edit dockerd || return 1
        expect dockerd globals.data_root "$DATA_MOUNT/docker/" || return 1
    fi

    # IPv6 for the router only: WAN obtains it, LAN gets none (proxy stays IPv4).
    i=0
    while zone=$(uci_get firewall "@zone[$i].name") && [ "$zone" != wan ]; do i=$((i + 1)); done
    uci_get firewall "@zone[$i].network" | grep -qw wan6 ||
        { fail 'wan6 不在防火墙 wan 区域，拒绝开启 IPv6'; return 1; }
    uci_edit network <<'EOF' || return 1
set PKG.wan.ipv6=1
set PKG.wan6=interface
set PKG.wan6.proto=dhcpv6
set PKG.wan6.device=@wan
set PKG.wan6.reqaddress=try
set PKG.wan6.reqprefix=auto
set PKG.wan6.disabled=0
EOF
    expect network wan.ipv6 1 && expect network wan6.device @wan && expect network wan6.disabled 0 || return 1
    [ -z "$(uci_get network lan.ip6assign)" ] || { fail 'LAN 配置了 IPv6 分配，与不下发要求冲突'; return 1; }
    uci_edit dhcp <<'EOF' || return 1
set PKG.lan.ra=disabled
set PKG.lan.dhcpv6=disabled
set PKG.lan.ndp=disabled
set PKG.@dnsmasq[0].filter_aaaa=1
EOF
    expect dhcp lan.ra disabled && expect dhcp lan.dhcpv6 disabled && expect dhcp lan.ndp disabled &&
        expect dhcp '@dnsmasq[0].filter_aaaa' 1 || return 1

    # Watchcat: check domestic hosts; redial after 10 min, keep the reboot rule's period.
    [ -f "$conf/watchcat" ] || : > "$conf/watchcat"
    {
        i=0
        while mode=$(uci_get watchcat "@watchcat[$i].mode"); do
            [ "$mode" != ping_reboot ] || echo "set PKG.@watchcat[$i].pinghosts='$hosts'"
            i=$((i + 1))
        done
        echo "set PKG.wan_redial=watchcat"
        echo "set PKG.wan_redial.mode=run_script"
        echo "set PKG.wan_redial.period=10m"
        echo "set PKG.wan_redial.pinghosts='$hosts'"
        echo "set PKG.wan_redial.script=/usr/libexec/wan-redial"
    } > "$WORK/watchcat.batch"
    uci_edit watchcat < "$WORK/watchcat.batch" || return 1
    expect watchcat wan_redial.mode run_script && expect watchcat wan_redial.pinghosts "$hosts" || return 1
    i=0
    while mode=$(uci_get watchcat "@watchcat[$i].mode"); do
        [ "$mode" != ping_reboot ] || expect watchcat "@watchcat[$i].pinghosts" "$hosts" || return 1
        i=$((i + 1))
    done

    write_expectations "$WORK/migration" "$TAG" || return 1
    pack_config "$WORK/migration" "$WORK/ssd-config.tar.gz" && gzip -t "$WORK/ssd-config.tar.gz"
}

write_target() {
    target=$1
    data=$(partition_device "$target" 4)
    raw=$(gzip -dc "$IMAGE" | wc -c) || return 1
    want=$(gzip -dc "$IMAGE" | sha256sum | cut -d ' ' -f 1) || return 1
    printf '写入 %s ...\n' "$target"
    gzip -dc "$IMAGE" | dd of="$target" bs=4M conv=fsync 2>/dev/null || { fail '写入失败'; return 1; }
    sync; echo 3 > /proc/sys/vm/drop_caches
    got=$(dd if="$target" bs=4M 2>/dev/null | head -c "$raw" | sha256sum | cut -d ' ' -f 1)
    [ "$got" = "$want" ] || { fail '写入后读回校验不一致'; return 1; }
    # The image GPT ends at the image size; move the backup header to the disk end.
    sgdisk -e "$target" >/dev/null || { fail '无法修正 GPT'; return 1; }
    sgdisk -n "4:$DATA_START:0" -t 4:8300 -c 4:data "$target" >/dev/null || { fail '无法创建数据分区'; return 1; }
    partx -d - "$target" 2>/dev/null || :
    partx -a - "$target" || :
    i=0; while ! is_block "$data" && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
    is_block "$data" || { fail "找不到 $data"; return 1; }
    openwrt_call /lib partition_map "$target" > "$WORK/target.partitions" || return 1
    layout_compatible "$WORK/target.partitions" "$WORK/expected.partitions" || {
        fail '写入后的分区表与预期不符'; return 1;
    }
    mkfs.ext4 -F -q -L data "$data" || { fail '数据分区格式化失败'; return 1; }
    uuid=$(blkid -s UUID -o value "$data") && [ -n "$uuid" ] || { fail '无法读取数据分区 UUID'; return 1; }
    store=$WORK/target-data
    mkdir -p "$store" && mount -t ext4 "$data" "$store" || { fail '无法挂载新数据分区'; return 1; }
    # The installed image is the first rollback point once the next upgrade happens.
    if mkdir -p "$store/firmware/$TAG" && store_file "$IMAGE" "$store/firmware/$TAG/image.img.gz" &&
        printf '%s\n' "$(sha < "$IMAGE")" > "$store/firmware/$TAG/image.sha256"; then
        umount "$store"
    else
        umount "$store"; fail '无法在数据分区保存固件镜像'; return 1
    fi
    ssd_config "$uuid" || { fail '无法生成 SSD 配置'; return 1; }
    boot=$WORK/target-boot
    mkdir "$boot"
    mount -t vfat -o rw,noatime "$(partition_device "$target" 1)" "$boot" || { fail '无法挂载新启动分区'; return 1; }
    # Preinit moves this file into place and restores it on the first boot.
    if cp "$WORK/ssd-config.tar.gz" "$boot/sysupgrade.tgz" && sync && cmp -s "$WORK/ssd-config.tar.gz" "$boot/sysupgrade.tgz"; then
        umount "$boot"
    else
        umount "$boot"; fail '配置未能写入新启动分区'; return 1
    fi
    printf '\n完成：%s 已写入 %s，数据分区 %s 将挂载到 %s，首次启动自动恢复当前配置。\n' "$TAG" "$target" "$data" "$DATA_MOUNT"
    printf '当前系统和 U 盘未改动。请在 BIOS 中把 SSD 设为第一启动项；U 盘保留作回退。\n'
}

sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -d ' ' -f 1; }

# Settings whose restoration is checked after the upgrade (stored as hashes only).
CHECK_KEYS='network.lan.ipaddr network.lan.device network.wan.proto network.wan.device
network.wan.username network.wan.password network.wan.ipv6 network.wan6.disabled
dropbear.@dropbear[0].Port system.@system[0].hostname system.@system[0].zonename
luci.main.mediaurlbase dhcp.lan.ra dhcp.@dnsmasq[0].filter_aaaa firewall.@defaults[0].input
openclash.config.enable openclash.config.config_path lucky.@lucky[0].enabled
tailscale.settings.service_enabled tailscale.settings.advertise_routes
dockerd.globals.data_root fstab.ssd_data.uuid watchcat.wan_redial.mode sqm.eth1.upload'

write_expectations() {
    # write_expectations DIR TAG: what the first boot of TAG must find restored.
    conf=$1/etc/config
    mkdir -p "$1/etc/firmware-update" || return 1
    {
        printf 'tag %s\n' "$2"
        for key in $CHECK_KEYS; do
            pkg=${key%%.*}
            [ -f "$conf/$pkg" ] || continue
            value=$(uci_get "$pkg" "${key#*.}") || continue
            printf 'value %s %s\n' "$key" "$(printf '%s' "$value" | sha)"
        done
        for dir in etc/config/lucky.daji etc/tailscale etc/openclash/config; do
            if [ -d "$1/$dir" ]; then
                (cd "$1" && find "$dir" -type f -size +0) | sed 's#^#file /#'
            fi
        done
    } > "$1/etc/firmware-update/expected"
}

filter_backup() {
    # Preserve private configuration/identities and disabled-service state, not old program code.
    awk '
      /^\// { sub(/^\//, "") }
      /(^|\/)\.\.(\/|$)/ { next }
      /^etc\/openclash\/core(\/|$)/ { next }
      /^etc\/openclash\/clash$/ { next }
      # Nikki is no longer built; OpenClash is the only proxy application.
      /^etc\/nikki(\/|$)/ { next }
      /^etc\/config\/nikki$/ { next }
      /^etc\/apk\/repositories.d\/distfeeds.list$/ { next }
      { print }
    '
}

pack_config() {
    # pack_config DIR ARCHIVE: files and links only, like `sysupgrade -b`. Directory
    # entries would carry this script's umask 077 onto / and /etc of the restored
    # system; non-root ubusd then cannot start and boot hangs at "procd: - ubus -".
    (cd "$1" && find . ! -type d | sed 's|^\./||') > "$2.list" || return 1
    [ -s "$2.list" ] || { fail '配置目录为空'; return 1; }
    tar -czf "$2" -C "$1" -T "$2.list" || return 1
    rm -f "$2.list"
    ! tar -tvzf "$2" | grep -q '^d' || { fail '配置包含目录条目，拒绝使用'; return 1; }
}

make_backup() {
    sysupgrade -b "$WORK/full-backup.tar.gz" || { fail '配置备份失败'; return 1; }
    gzip -t "$WORK/full-backup.tar.gz" || return 1
    mkdir "$WORK/migration"
    tar -tzf "$WORK/full-backup.tar.gz" > "$WORK/backup-members.txt" || return 1
    filter_backup < "$WORK/backup-members.txt" > "$WORK/migration-members.txt"
    tar -xzf "$WORK/full-backup.tar.gz" -C "$WORK/migration" -T "$WORK/migration-members.txt" || return 1
    for config in network dropbear system luci; do
        [ -s "$WORK/migration/etc/config/$config" ] || { fail "缺少必要配置：$config"; return 1; }
    done
    # These directories contain user secrets; never print their contents or upload them.
    for directory in /etc/config/lucky.daji /etc/tailscale /etc/openclash/config /etc/openclash/custom; do
        if [ -d "$directory" ]; then
            mkdir -p "$WORK/migration$directory"
            cp -a "$directory/." "$WORK/migration$directory/" || return 1
        fi
    done
    write_expectations "$WORK/migration" "$TAG" || { fail '无法生成配置核对清单'; return 1; }
    pack_config "$WORK/migration" "$WORK/migration-backup.tar.gz" || return 1
    gzip -t "$WORK/migration-backup.tar.gz" || return 1
    verify_backup="$WORK/migration-backup.tar.gz"
    BACKUP_SHA=$(sha256sum "$verify_backup" | cut -d ' ' -f 1)
    printf '\n请通过现有 SSH/SCP 保存到自己的电脑，勿上传 GitHub：\n%s/full-backup.tar.gz\n%s/migration-backup.tar.gz\n' "$WORK" "$WORK"
    printf '完整备份用于恢复旧系统；迁移备份排除了旧 OpenClash 核心与包代码。\n'
}

STORE=${STORE:-$DATA_MOUNT/firmware}
BUILD_FILE=${BUILD_FILE:-/etc/firmware-build.json}

interactive() { [ -t 0 ]; }
data_mounted() { grep -q " $DATA_MOUNT " "${PROC_MOUNTS:-/proc/mounts}"; }
current_tag() { jq -er '.tag' "$BUILD_FILE" 2>/dev/null; }
# shellcheck disable=SC2153 # PART is assigned by export_partdevice (eval).
boot_part() { export_bootdevice && export_partdevice PART 1 && printf '%s\n' "$PART"; }

check_boot_space() {
    # sysupgrade copies the configuration to the boot partition without checking
    # the copy. Prove now that it is writable, has room and reads back intact.
    part=$(openwrt_call /lib boot_part) && [ -n "$part" ] || { fail '无法确定启动分区'; return 1; }
    mnt=$WORK/boot-check
    mkdir -p "$mnt"
    mount -o rw,noatime "/dev/$part" "$mnt" || { fail '启动分区无法以读写方式挂载'; return 1; }
    need=$(( $(wc -c < "$1") * 2 / 1024 + 1024 ))
    free=$(df -Pk "$mnt" | awk 'END {print $4}')
    ok=1
    if [ "$free" -gt "$need" ] && cp "$1" "$mnt/.firmware-update-check" && sync &&
        cmp -s "$1" "$mnt/.firmware-update-check"; then
        ok=0
    fi
    rm -f "$mnt/.firmware-update-check"
    umount "$mnt"
    [ "$ok" = 0 ] || { fail "启动分区不可写或空间不足（需要 ${need} KiB，剩余 ${free} KiB）"; return 1; }
}

store_file() {
    # store_file SRC DEST: copy, then confirm the stored bytes.
    cp "$1" "$2.part" && sync && cmp -s "$1" "$2.part" && mv "$2.part" "$2" || { rm -f "$2.part"; return 1; }
}

keep_rollback() {
    # Keep what is needed to return to the firmware being left: its image (saved
    # when it was installed) and its configuration at this moment. Only on upgrades.
    if ! data_mounted; then
        printf '未挂载 SSD 数据分区，本次升级不建立回退点。\n'
        return 0
    fi
    current=$(current_tag) || { printf '当前固件不是本项目发布，本次升级不建立回退点。\n'; return 0; }
    size=$(wc -c < "$IMAGE")
    free=$(df -Pk "$DATA_MOUNT" 2>/dev/null | awk 'END {print $4}')
    [ -z "$free" ] || [ "$free" -gt $((size * 3 / 1024)) ] || { fail '数据分区空间不足，无法建立回退点'; return 1; }
    mkdir -p "$STORE/$current" "$STORE/$TAG" || { fail '无法创建回退目录'; return 1; }
    write_expectations "$WORK/migration" "$current" &&
        pack_config "$WORK/migration" "$WORK/rollback-config.tar.gz" &&
        write_expectations "$WORK/migration" "$TAG" &&
        store_file "$WORK/rollback-config.tar.gz" "$STORE/$current/config.tar.gz" ||
        { fail '无法保存回退配置'; return 1; }
    store_file "$IMAGE" "$STORE/$TAG/image.img.gz" &&
        printf '%s\n' "$(sha < "$IMAGE")" > "$STORE/$TAG/image.sha256" || { fail '无法保存新固件镜像'; return 1; }
    if [ ! -s "$STORE/$current/image.img.gz" ]; then
        printf '警告：SSD 上没有 %s 的镜像，回退到它将不可用。\n' "$current"
    fi
    printf '%s\n' "$current" > "$STORE/previous"
    for dir in "$STORE"/*/; do
        name=$(basename "$dir")
        [ "$name" = "$current" ] || [ "$name" = "$TAG" ] || rm -rf "$dir"
    done
    printf '已在 SSD 保留回退点：%s（firmware-update rollback）\n' "$current"
}

confirm_rollback() {
    printf '将回退到 %s，并恢复离开它时的配置；之后的配置改动会丢失。\n输入 ROLLBACK %s 确认：' "$1" "$1"
    IFS= read -r reply || return 1
    [ "$reply" = "ROLLBACK $1" ] || { fail '未确认回退'; return 1; }
}

image_partitions() {
    image_header "$1" "$WORK/image.header"
    openwrt_call /lib partition_map "$WORK/image.header" > "$WORK/expected.partitions"
}

rollback() {
    data_mounted || { fail '未挂载 SSD 数据分区'; return 1; }
    target=$(cat "$STORE/previous" 2>/dev/null) && [ -n "$target" ] || { fail '没有可回退的版本'; return 1; }
    dir=$STORE/$target
    for file in image.img.gz image.sha256 config.tar.gz; do
        [ -s "$dir/$file" ] || { fail "回退点不完整：$dir/$file"; return 1; }
    done
    verify_asset "$dir/image.img.gz" "$(cut -d ' ' -f 1 < "$dir/image.sha256")" || return 1
    gzip -t "$dir/config.tar.gz" || { fail '回退配置已损坏'; return 1; }
    image_partitions "$dir/image.img.gz" || return 1
    check_layout || return 1
    sysupgrade -T "$dir/image.img.gz" || { fail 'sysupgrade 镜像检查未通过'; return 1; }
    confirm_rollback "$target" || return 1
    # Keep the firmware being left reachable again ("roll forward").
    current=$(current_tag) || current=
    if [ -n "$current" ]; then
        TAG=$current
        make_backup || return 1
        mkdir -p "$STORE/$current" && store_file "$WORK/migration-backup.tar.gz" "$STORE/$current/config.tar.gz" &&
            printf '%s\n' "$current" > "$STORE/previous" || { fail '无法保存当前配置'; return 1; }
    fi
    check_device
    check_boot_space "$dir/config.tar.gz"
    sysupgrade -f "$dir/config.tar.gz" "$dir/image.img.gz"
}

confirm_upgrade() {
    [ "${LAYOUT_CHANGE:-}" != 1 ] || printf '本次为分区布局变化后的整盘重写（配置保留，overlay 上自装的软件包需重装）。\n'
    printf '确认两个备份已保存到电脑后，输入 BACKUP-SAVED：'
    IFS= read -r reply || return 1
    [ "$reply" = BACKUP-SAVED ] || { fail '未确认已留存备份'; return 1; }
    printf '即将升级并重启。输入完整版本号 %s 确认：' "$1"
    IFS= read -r reply || return 1
    [ "$reply" = "$1" ] || { fail '未确认升级'; return 1; }
}

main() {
    mode=${1:-check}
    case "$mode" in
        check|prepare|upgrade|rollback) ;;
        verify)
            /usr/libexec/config-check -f; status=$?
            cat /etc/firmware-update/last-check 2>/dev/null || printf '没有待核对的升级配置。\n'
            exit "$status" ;;
        migrate) [ -n "${2:-}" ] || { fail '用法：firmware-update migrate /dev/目标盘'; exit 1; } ;;
        *) fail '用法：firmware-update [check|prepare|upgrade|verify|rollback|migrate /dev/目标盘]'; exit 1;;
    esac
    [ "$(id -u)" = 0 ] || { fail '需要 root'; exit 1; }
    case "$mode" in upgrade|migrate|rollback)
        interactive || { fail '升级、迁移和回退必须在交互终端手动确认'; exit 1; } ;;
    esac
    for tool in curl jq sha256sum gzip tar apk sysupgrade cmp hexdump netstat; do
        command -v "$tool" >/dev/null || { fail "缺少命令：$tool"; exit 1; }
    done
    check_device
    WORK=$(mktemp -d /tmp/firmware-update.XXXXXX)
    printf '本次临时目录：%s\n' "$WORK"
    if [ "$mode" = migrate ]; then
        migrate "$2"
        return
    fi
    if [ "$mode" = rollback ]; then
        rollback
        return
    fi
    if [ -r /etc/firmware-update/last-check ]; then
        printf '上次升级后配置核对：%s\n' "$(head -n 1 /etc/firmware-update/last-check)"
    fi
    get_release
    [ "${UP_TO_DATE:-0}" != 1 ] || return 0
    [ "$mode" != check ] || return 0
    read_device_layout
    prepare_image
    make_backup
    [ "$mode" != prepare ] || return 0
    confirm_upgrade "$TAG"
    # Recheck immediately before the only flashing command. No force/reset/whole-disk flags.
    check_device
    read_device_layout
    verify_asset "$IMAGE" "$(jq -r .image.sha256 "$WORK/release.json")"
    verify_asset "$WORK/migration-backup.tar.gz" "$BACKUP_SHA"
    sysupgrade -T "$IMAGE"
    check_boot_space "$WORK/migration-backup.tar.gz"
    keep_rollback
    sysupgrade -f "$WORK/migration-backup.tar.gz" "$IMAGE"
}

migrate() {
    for tool in sgdisk partx mkfs.ext4 blkid uci; do
        command -v "$tool" >/dev/null || { fail "缺少命令：$tool"; return 1; }
    done
    check_target_disk "$1"
    get_release
    jq -r '.image.partitions[] | @tsv' "$WORK/release.json" > "$WORK/expected.partitions"
    system_fits_before_data "$WORK/expected.partitions" || { fail '系统分区会覆盖数据分区起点'; return 1; }
    prepare_image
    image_header "$IMAGE" "$WORK/image.header"
    distinct_root_ids "$WORK/image.header" "/dev/$(boot_disk)"
    make_backup
    confirm_migration "$1"
    # Recheck right before the only destructive step.
    check_target_disk "$1"
    verify_asset "$IMAGE" "$(jq -r .image.sha256 "$WORK/release.json")"
    write_target "$1"
}

# This also permits sourcing the validation functions without starting an update.
case "${0##*/}" in firmware-update|firmware-update.sh) main "$@";; esac
