#!/bin/sh
# Keep vnstat traffic history on the SSD data partition instead of RAM, and
# count the WAN port. Only fills in what the administrator has not set.
conf=${VNSTAT_CONF:-/etc/vnstat.conf}

if [ -f "$conf" ] && ! grep -q '^[[:space:]]*DatabaseDir' "$conf"; then
	printf '\n# SSD data partition: history survives reboots and upgrades.\nDatabaseDir "/mnt/data/vnstat"\n' >> "$conf"
fi

if ! uci -q get 'vnstat.@vnstat[0].interface' >/dev/null; then
	uci -q add_list 'vnstat.@vnstat[0].interface=eth0' && uci -q commit vnstat
fi

exit 0
